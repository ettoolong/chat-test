# Copy this file to .env and adjust as needed. All values shown are defaults.

PORT=3001
CORS_ORIGIN=http://localhost:5173

# Absolute or relative path to the GGUF model file.
# Defaults to ../models/gemma-4-E4B-it-Q4_K_M.gguf relative to this project.
# MODEL_PATH=

# Tokens of context per session (system prompt + conversation history).
CONTEXT_SIZE=8192

# Max number of concurrent chat sessions (each holds its own KV-cache sequence).
MAX_SESSIONS=3

# Idle sessions are freed after this many milliseconds without a new message.
SESSION_IDLE_TIMEOUT_MS=1800000

# Path to the file containing the system prompt to pre-cache.
# SYSTEM_PROMPT_FILE=./system-prompt.txt
