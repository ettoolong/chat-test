+Napi::Value AddonContext::SetEmbeddingsNextn(const Napi::CallbackInfo& info) {
+    if (disposed) {
+        Napi::Error::New(info.Env(), "Context is disposed").ThrowAsJavaScriptException();
+        return info.Env().Undefined();
+    }
+
+    const bool value = info[0].As<Napi::Boolean>().Value();
+    const bool masked = info[1].As<Napi::Boolean>().Value();
+
+    llama_set_embeddings_nextn(ctx, value, masked);
+
+    return info.Env().Undefined();
+}
+
+Napi::Value AddonContext::GetEmbeddingsNextnIth(const Napi::CallbackInfo& info) {
+    if (disposed) {
+        Napi::Error::New(info.Env(), "Context is disposed").ThrowAsJavaScriptException();
+        return info.Env().Undefined();
     }
 
+    int32_t i = info[0].As<Napi::Number>().Int32Value();
+
+    const int n_embd = llama_model_n_embd(model->model);
+    const auto* embeddings = llama_get_embeddings_nextn_ith(ctx, i);
+
+    if (embeddings == NULL) {
+        Napi::Error::New(info.Env(), std::string("Failed to get nextn embeddings for token ") + std::to_string(i)).ThrowAsJavaScriptException();
+        return info.Env().Undefined();
+    }
+
+    Napi::Float64Array result = Napi::Float64Array::New(info.Env(), n_embd);
+    for (int j = 0; j < n_embd; j++) {
+        result[j] = embeddings[j];
+    }
+
     return result;
 }
 
