@@ -0,0 +1,100 @@
+import {Token} from "../../../types.js";
+import {TokenPredictor} from "../TokenPredictor.js";
+import {LlamaContextSequence} from "../LlamaContext.js";
+
+const defaultMaxDraftTokens = 3;
+const defaultMinConfidence = 0;
+
+/**
+ * Predicts the next tokens using a Gemma 4 MTP (multi-token prediction) assistant/drafter
+ * model - a small model that cross-attends to the target model's own KV cache and recurrently
+ * proposes candidate continuation tokens from the target's NextN hidden state (`h_nextn`).
+ *
+ * Unlike {@link DraftSequenceTokenPredictor}, the drafter here isn't a full standalone model
+ * generating independently - it's tightly coupled to the target context it was created against
+ * (via the `otherContext` option on `createContext`) and only proposes tokens when it has a
+ * NextN hidden state to seed from, which is only available right after a real token has been
+ * decoded on the target sequence.
+ *
+ * @see [Using Token Predictors: Draft Model Token Predictor](https://node-llama-cpp.withcat.ai/guide/token-prediction#draft-model)
+ */
+export class Gemma4MtpTokenPredictor extends TokenPredictor {
+    /** @internal */ private readonly _mtpSequence: LlamaContextSequence;
+    /** @internal */ private readonly _maxDraftTokens: number;
+    /** @internal */ private readonly _minConfidence: number;
+    /** @internal */ private _embeddingsNextnEnabled: boolean = false;
+    /** @internal */ private _targetSequence?: LlamaContextSequence;
+    /** @internal */ private _lastToken?: Token;
+    /** @internal */ private _pendingH?: Float64Array;
+    /** @internal */ private _disposed: boolean = false;
+
+    public constructor(mtpSequence: LlamaContextSequence, options: {
+        /**
+         * Maximum number of speculative tokens to draft per round.
+         *
+         * Defaults to `3`.
+         */
+        maxDraftTokens?: number,
+
+        /**
+         * Stop drafting further tokens in a round once the drafter's own confidence
+         * (the softmax probability of its top pick) drops below this value.
+         *
+         * Defaults to `0` (disabled - always draft up to `maxDraftTokens`).
+         */
+        minConfidence?: number
+    } = {}) {
+        super();
+
+        this._mtpSequence = mtpSequence;
+        this._maxDraftTokens = options.maxDraftTokens ?? defaultMaxDraftTokens;
+        this._minConfidence = options.minConfidence ?? defaultMinConfidence;
+    }
+
+    public override needsEmbeddingNextn: boolean = true;
+
+    public override reset({targetSequence}: {targetSequence: LlamaContextSequence}) {
+        this._targetSequence = targetSequence;
+        this._lastToken = undefined;
+        this._pendingH = undefined;
+
+        // Enabling this repeatedly across turns is a cheap, idempotent native call - simplest
+        // to just guarantee it's on here rather than relying on external setup code to remember.
+        if (!this._embeddingsNextnEnabled) {
+            this._mtpSequence.context._ctx.setEmbeddingsNextn(true, true);
+            this._embeddingsNextnEnabled = true;
+        }
+    }
+
+    public override pushTokens(tokens: Token[], nextnEmbedding?: Float64Array) {
+        this._lastToken = tokens.at(-1);
+        this._pendingH = nextnEmbedding;
+    }
+
+    public override async predictTokens(): Promise<Token[]> {
+        // No NextN hidden state to seed drafting with yet (e.g. the very first token of a new
+        // generation turn, before any real decode has happened on the target sequence) - skip
+        // drafting for this round rather than trying to invent a seed.
+        if (this._lastToken == null || this._pendingH == null || this._targetSequence == null)
+            return [];
+
+        const draftTokens = await this._mtpSequence.context._ctx.runMtpDraft(
+            this._lastToken,
+            this._pendingH,
+            this._targetSequence.nextTokenIndex,
+            this._mtpSequence._sequenceId,
+            this._maxDraftTokens,
+            this._minConfidence
+        );
+
+        return Array.from(draftTokens) as Token[];
+    }
+
+    public override async dispose() {
+        if (this._disposed)
+            return;
+
+        this._disposed = true;
+        await this._mtpSequence.dispose();
+    }
+}
